local function malformed_line(filename, linenum, line)
	print_to_console("[Metadata Patches] Ignoring malformed line/instruction")
	print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
	print_to_console("[Metadata Patches] - What: "..line)
end

local function evaluate_should_skip(filename, linenum, line, cond)
	local ok, ret = load("return "..cond, "condition", "t", $object(can_add_new_types, compareversions, owf_get_build_version))
	if ok then
		ok, ret = pcall(ok)
		if ok then
			return not ret
		end
	end
	print_to_console("[Metadata Patches] $if condition errored: "..ret)
	print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
	print_to_console("[Metadata Patches] - What: "..line)
	return true
end

function parse_metadata_patches(str, filename)
	local patches = {}
	local patch = { keys = {}, prefix = "", replacements = {}, substitutions = {}, query_assignments = {}, appends = {} }
	local ampersand = false
	local skipblocks = { false }
	local function delimit_patch()
		if #patch.keys ~= 0 then
			patches:insert(patch)
		end
		patch = { keys = {}, prefix = "", replacements = {}, substitutions = {}, query_assignments = {}, appends = {} }
	end
	local function is_in_patch_scope(linenum, line, is_instruction)
		local reason
		if #patch.keys == 0 then
			reason = "Ignoring line/instruction that was not preceeded by one or more paths/targets"
		elseif is_instruction and patch.new_type then
			reason = "Ignoring instruction that is not supported for new types"
		else
			return true
		end
		print_to_console("[Metadata Patches] "..reason)
		print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
		print_to_console("[Metadata Patches] - What: "..line)
		return false
	end
	for linenum, line in str:split("\n") do
		local stripped_line = line:strip()

		if stripped_line:startswith("$if ") then
			local should_skip = evaluate_should_skip(filename, linenum, stripped_line, stripped_line:sub(5))
			skipblocks:insert(skipblocks[#skipblocks] and 0 or should_skip)
			continue
		end
		if stripped_line:startswith("$elseif ") then
			if #skipblocks == 1 then
				print_to_console("[Metadata Patches] $elseif without matching $if")
				print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
			else
				local should_skip = evaluate_should_skip(filename, linenum, stripped_line, stripped_line:sub(9))
				skipblocks[#skipblocks] = skipblocks[#skipblocks] == true ? should_skip : 0
			end
			continue
		end
		if stripped_line:startswith("$else") then
			if #skipblocks == 1 then
				print_to_console("[Metadata Patches] $else without matching $if")
				print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
			else
				skipblocks[#skipblocks] = skipblocks[#skipblocks] == true ? false : 0
			end
			continue
		end
		if stripped_line:startswith("$endif") then
			if #skipblocks == 1 then
				print_to_console("[Metadata Patches] $endif without matching $if")
				print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
			else
				skipblocks:remove()
			end
			continue
		end
		if skipblocks[#skipblocks] then
			continue
		end

		if line:startswith("/") then
			if ampersand then
				ampersand = false
			else
				delimit_patch()
				print_to_console("[Metadata Patches] Starting a patch via / is deprecated.")
				print_to_console("[Metadata Patches] - Note: If this was intentional, prefix a right angle bracket (>). Otherwise, use indentation.")
				print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
				print_to_console("[Metadata Patches] - What: "..line)
			end
			line = line:strip()
			if line[-1] == "&" then
				ampersand = true
				line = line:sub(1, -2):strip()
			end
			for line:split("&") as key do
				patch.keys:insert(key:strip())
			end
			continue
		end
		line = stripped_line
		ampersand = false
		if line:startswith("&") then
			ampersand = true
			line = line:sub(2):strip()
			if line[-1] == "&" then
				line = line:sub(1, -2):strip()
			end
			for line:split("&") as key do
				patch.keys:insert(key:strip())
			end
		elseif line:startswith(">") then
			delimit_patch()
			line = line:sub(2):strip()
			if line[-1] == "&" then
				ampersand = true
				line = line:sub(1, -2):strip()
			end
			for line:split("&") as key do
				patch.keys:insert(key:strip())
			end
		elseif line:startswith("+") then
			delimit_patch()
			ampersand = false
			if sep := line:find("|", 2) then
				local path = line:sub(2, sep - 1):strip()
				patch.keys:insert(path)
				patch.new_type = { path = path, parent = line:sub(sep + 1):strip() }
			else
				malformed_line(filename, linenum, line)
			end
		elseif line:startswith("r|") then
			if sep := line:find("|", 3) then
				if is_in_patch_scope(linenum, line, true) then
					patch.replacements[line:sub(3, sep - 1)] = line:sub(sep + 1):rstrip("|")
				end
			else
				malformed_line(filename, linenum, line)
			end
		elseif line:startswith("s|") then
			if sep := line:find("|", 3) then
				if is_in_patch_scope(linenum, line, true) then
					patch.substitutions[line:sub(3, sep - 1)] = line:sub(sep + 1):rstrip("|")
				end
			else
				malformed_line(filename, linenum, line)
			end
		elseif line:startswith("q|") then
			if sep := line:find("|", 3) then
				if is_in_patch_scope(linenum, line, true) then
					patch.query_assignments[line:sub(3, sep - 1)] = line:sub(sep + 1):rstrip("|")
				end
			else
				malformed_line(filename, linenum, line)
			end
		elseif line:startswith("a|") then
			if sep := line:find("|", 3) then
				if is_in_patch_scope(linenum, line, true) then
					patch.appends:insert({ line:sub(3, sep - 1), line:sub(sep + 1):rstrip("|") })
				end
			else
				malformed_line(filename, linenum, line)
			end
		elseif line:startswith("$") then
			if is_in_patch_scope(linenum, line, true) then
				for line:sub(2):split(";") as flag do
					if flag == "clear" then
						patch.discard_original = true
					elseif flag == "debug" then
						patch.debug = true
					else
						print_to_console("[Metadata Patches] Ignoring unknown flag: "..flag)
						print_to_console("[Metadata Patches] - Where: "..(filename ?? "?")..":"..linenum)
						print_to_console("[Metadata Patches] - What: "..line)
					end
				end
			end
		elseif #line ~= 0 and line[1] ~= "#" then
			if is_in_patch_scope(linenum, line) then
				patch.prefix = patch.prefix .. line .. "\n"
			end
		end
	end
	if #patch.keys ~= 0 then
		patches:insert(patch)
	end
	if #skipblocks ~= 1 then
		print_to_console("[Metadata Patches] $if without matching $endif")
		print_to_console("[Metadata Patches] - Where: "..(filename ?? "?"))
	end
	return patches
end

function load_metadata_patches(str, filename)
	for parse_metadata_patches(str, filename) as patch do
		if patch.new_type then
			add_new_type(patch.new_type.path, patch.new_type.parent)
		end
		for patch.keys as key do
			if key[1] ~= "/" then
				print_to_console("[Metadata Patches] Can't patch invalid path: "..key)
				print_to_console("[Metadata Patches] - Note: > and & are used to start new patches and therefore need to be followed by valid paths to patch.")
				continue
			end
			new_patch(key, patch.prefix, patch.discard_original, patch.debug)
			for k, v in patch.replacements do
				add_replacement(k, v)
			end
			for k, v in patch.substitutions do
				if err := add_substitution(k, v, "") then
					print_to_console("[Metadata Patches] Regex parsing failed for "..k..": "..err)
				end
			end
			for k, v in patch.query_assignments do
				add_query_assignment(k, v)
			end
			for patch.appends as append do
				add_append(append[1], append[2])
			end
		end
	end
end

if io.exists("OpenWF/Metadata Patches.txt") then
	if not io.exists("OpenWF/Metadata Patches/Untitled.txt") then
		io.mkdir("OpenWF/Metadata Patches")
		io.rename("OpenWF/Metadata Patches.txt", "OpenWF/Metadata Patches/Untitled.txt")
	end
elseif not io.exists("OpenWF/Metadata Patches") then
	io.mkdir("OpenWF/Metadata Patches")
	io.contents("OpenWF/Metadata Patches/Untitled.txt", owf_repo_find("OpenWF/Metadata Patches.txt"))
end

for io.listdir("OpenWF/Metadata Patches/", true) as path do
	if path:sub(-4) == ".txt" then
		if str := io.contents(path) then
			load_metadata_patches(str, io.relative(path))
		end
	end
end
