coroutine.sleep = function(ms)
	local t = os.millis() + ms
	repeat
		yield()
	until t <= os.millis()
end

Sleep = coroutine.sleep

owf_internal_event_queue = {}
owf_lambda_callbacks = {}
owf_flash_callbacks = {}
owf_next_event = || -> owf_internal_event_queue:remove(1)

ivkr_push_callback = function(callback)
	local callbackName = tostring(callback)
	if type(callback) == "function" then
		owf_lambda_callbacks[callbackName] = callback
	end
	ivkr_push_string("OWF_"..owf_script_get_name()..callbackName)
	owf_register_callback(callbackName)
end

ivkr_push_any = function(val)
	switch type(val) do
		case "nil":
			ivkr_push_nil()
			return true

		case "boolean":
			ivkr_push_bool(val)
			return true

		case "number":
			if math.type(val) == "integer" do
				ivkr_push_int(val)
			else
				ivkr_push_float(val)
			end
			return true

		case "string":
			ivkr_push_string(val)
			return true

		case "table":
			ivkr_newtable()
			for k, v in val do
				if not ivkr_push_any(k) or not ivkr_push_any(v) then
					ivkr_pop(1)
					return false
				end
				ivkr_settable(-3)
			end
			return true

		case "function":
			local cid = #owf_flash_callbacks + 1
			owf_flash_callbacks[cid] = val
			ivkr_push_callback2(cid)
			return true
	end
	print("Unexpected value: "..dumpvar(val))
	return false
end

ivkr_pop_any = function(lim = 2)
	switch ivkr_type(-1) do
		case IVKR_NIL:
			ivkr_pop(1)
			return nil

		case IVKR_BOOL:
			return ivkr_pop_bool()

		case IVKR_NUMBER:
			return ivkr_pop_number()

		case IVKR_STRING:
			return ivkr_pop_string()

		case IVKR_TABLE:
			if lim == 0 then
				ivkr_pop(1)
				return { __not_walked__ = "Depth limit reached" }
			else
				local t = {}
				ivkr_push_nil()
				while ivkr_next(-2) do
					local v = ivkr_pop_any(lim - 1)
					ivkr_push_value(-1)
					local k = ivkr_pop_any(lim - 1)
					t[k] = v
				end
				ivkr_pop(1)
				return t
			end
	end
	local typename = ivkr_typename(-1)
	ivkr_pop(1)
	return { __not_walked__ = "Unsupported type: "..typename }
end

local function errorfunc(e)
	if type(e) == "string" and e:sub(-14) == "Stop requested" then
		print(e)
	else
		print(debug.traceback(e,2))
	end
end

function owf_internal_callback(cid, nargs)
	local args = {}
	for i = 1, nargs do
		ivkr_push_value(-i)
		args[nargs - i + 1] = ivkr_pop_any()
	end
	local t = table.pack(xpcall(owf_flash_callbacks[cid], errorfunc, table.unpack(args, 1, nargs)))
	if t[1] then
		for i = 2, t.n do
			if not ivkr_push_any(t[i]) then
				ivkr_push_nil()
			end
		end
		return t.n - 1
	end
	return 0
end

local script_commands = {}
function owf_register_command(cmd, cb)
	script_commands[cmd] = cb
	owf_register_dynamic_custom_route("/" .. cmd)
	register_websocket_message_prefix(cmd)
	owf_script_register_channel(cmd)
end
function owf_unregister_command(cmd)
	script_commands[cmd] = nil
	owf_unregister_dynamic_custom_route("/" .. cmd)
	unregister_websocket_message_prefix(cmd)
	owf_script_unregister_channel(cmd)
end
local function format_command_response(cmd, r)
	if type(r) ~= "table" then
		r = { [cmd] = r }
	end
	local s = json.encode(r)
	if s == "[]" then
		return "{}"
	end
	return s
end

return function(f)
	owf_script_route_base = owf_script_get_name()
	local is_bgscript = (owf_script_route_base == "OpenWF Background Script")
	if is_bgscript then
		owf_script_route_base = "/"..owf_script_route_base
	else
		owf_script_route_base = owf_script_get_name():sub(7)
	end
	owf_register_command(owf_script_route_base:sub(2).."/request_broadcast", function()
		return {
			from = owf_script_get_name(),
			script_broadcast = {
				toggles = owf_script_toggles,
			},
		}
	end)
	owf_register_command(owf_script_route_base:sub(2).."/set_toggle", function(arg)
		local value = arg:sub(1, 1) == "1"
		local name = arg:sub(2)
		if toggle := owf_script_toggles:find(|x| -> x.name == name) then
			toggle.value = value
		else
			print("Could not find a toggle called "..name)
		end
	end)

	coroutine.yield()

	local simple_yield = coroutine.yield
	coroutine.yield = yield

	local sched = new scheduler()
	function sched.yieldfunc()
		local nres
		while true do
			local cid, nargs = simple_yield(nres)
			if not cid then
				break
			end
			block_yield()
			nres = owf_internal_callback(cid, nargs)
			unblock_yield()
		end
	end
	sched.errorfunc = errorfunc
	owf_create_thread = |x| -> sched:add(x)
	local mainco
	sched:add(function()
		repeat
			simple_yield()

			-- Any instance we may have should be GC'd ASAP. This is necessary logic-wise for script replies.
			-- This should also avoid stuttering with long-running scripts as those may slow down Luau if they don't release references in a timely manner.
			collectgarbage("step")

			while evt := owf_internal_next_event() do
				if evt.type == OWF_EVT_CUSTOM_ROUTE_REQUEST then
					local path, arg = url.decode(evt.path):split("?", 2):unpack()
					if cb := script_commands[path:sub(2)] then
						sched:add(function()
							owf_dynamic_custom_route_response(evt.inst, "text/plain", format_command_response(path:sub(2), cb(arg)))
						end)
						continue
					end
				elseif evt.type == OWF_EVT_WEBSOCKET_MESSAGE then
					local cmd, arg = evt.text:split("?", 2):unpack()
					if cb := script_commands[cmd] then
						sched:add(function()
							local r = format_command_response(cmd, cb(arg))
							if #r > 2 then
								owf_broadcast_message(r, evt.sender)
							end
						end)
						continue
					end
				elseif evt.type == OWF_EVT_SUBMIT_CHAT_MESSAGE then
					if evt.blocked then
						sched:add(function()
							chat_add_to_sent_history(evt.text)
						end)
					end
				elseif evt.type == OWF_EVT_CALLBACK then
					evt.name = evt.name:sub(1 + #owf_script_get_name())
					if cb := owf_lambda_callbacks[evt.name] then
						sched:add(cb)
						owf_lambda_callbacks[evt.name] = nil
						continue
					end
				--[[elseif evt.type == OWF_EVT_SCRIPT_TRIGGERED then
					local arr = evt.data:split(":")
					evt.script = arr[1]
					evt.func = arr[2]
					evt.data = nil]]
				elseif evt.type == OWF_EVT_OUTGOING_CHAT_MESSAGE then
					local arr = evt.data:split(" :", 2)
					evt.channel = arr[1]
					evt.text = arr[2]
					evt.data = nil
				elseif evt.type == OWF_EVT_SCRIPT_MESSAGE then
					local data = json.decode(evt.data)
					if cb := script_commands[data.channel] then
						sched:add(function()
							owf_script_send_reply(evt.inst, format_command_response(data.channel, cb(data.text)))
						end)
						continue
					end
					evt.channel = data.channel
					evt.text = data.text
					evt.data = nil
				end
				owf_internal_event_queue:insert(evt)
			end
		until mainco:status() == "dead" and (owf_lambda_callbacks:size() == 0 or owf_get_stop_requested())
	end)
	mainco = sched:add(f)
	sched.yieldfunc()
	sched:run()
	if is_bgscript and not owf_get_stop_requested() then
		print("The background script has just died; some functionality will be unavailable. Want to try again? http://localhost:"..owf_get_client_http_port().."/start_bgscript")
	end
end
