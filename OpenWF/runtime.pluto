function ivkr_push_global(name)
	if compareversions(owf_get_build_version(), "2025.10.14.16.10") >= 0 then
		ivkr_push_int_as_bool(ivkr_hash(name))
	else
		ivkr_push_string(name)
	end
	ivkr_gettable(-10002)
end

local t_functions = {
	AddHudTracker = function(name, type)
		ivkr_push_global("_T")
		ivkr_push_string("AddHudTracker")
		ivkr_gettable(-2)

		ivkr_push_string(name)
		ivkr_push_int(type)
		ivkr_call2(2, 0)

		ivkr_pop(1)
	end,
	RemoveHudTracker = function(name)
		ivkr_push_global("_T")
		ivkr_push_string("RemoveHudTracker")
		ivkr_gettable(-2)

		ivkr_push_string(name)
		ivkr_call2(1, 0)

		ivkr_pop(1)
	end,
	OpenScreen = function(name)
		ivkr_push_global("_T")
		ivkr_push_string("OpenScreen")
		ivkr_gettable(-2)

		ivkr_push_string(name)
		ivkr_call2(1, 1)
		local ret = new FlashInstance()
		ivkr_pop(1)
		return ret
	end,
	ShowNotification = function(text, icon)
		ivkr_push_global("_T")
		ivkr_push_string("ShowNotification")
		ivkr_gettable(-2)

		if icon == nil and OWF_GAME_VERSION >= 430000 then
			icon = "DroneComplete" -- U43 requires an icon or it crashes directly
		end
		ivkr_push_any(text)
		ivkr_push_any(icon)
		ivkr_call2(2, 0)

		ivkr_pop(1)
	end,
}
_T = setmetatable({}, {
	function __index(name)
		ivkr_push_global("_T")
		ivkr_push_string(name)
		if ivkr_gettable(-2) > 0 then
			if func := t_functions[name] then
				ivkr_pop(2)
				return func
			end
		end
		local value = ivkr_pop_any()
		ivkr_pop(1)
		return value
	end,
	function __newindex(name, value)
		ivkr_push_global("_T")
		ivkr_push_string(name)
		ivkr_push_any(value)
		ivkr_settable(-3)
		ivkr_pop(1)
	end
})

ivkr_find_builtin = function(name)
	ivkr_push_global(name)
	return ivkr_pop_c_function()
end

