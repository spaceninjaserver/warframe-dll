local ivkr_find_global_cache = {}
function ivkr_find_global(name)
	local res = ivkr_find_global_cache[name]
	if not res then
		local hash = ivkr_hash(name)
		res = mem_read_i64(mem_scan_exe(string.format("%02X %02X %02X %02X 00 00 00 00", hash & 0xff, (hash >> 8) & 0xff, (hash >> 16) & 0xff, hash >> 24)) + 8)
		ivkr_find_global_cache[name] = res
	end
	return res
end

function IsNull(val)
	if val instanceof owfUserdata then
		val:pushToIvkr()
		ivkr_call(ivkr_find_global("IsNull"), 1)
		return ivkr_pop_bool()
	end
	return not val
end

class Type
	function __construct(public name)
	end

	function pushToIvkr()
		ivkr_push_string(self.name)
		ivkr_call(ivkr_find_global("Type"), 1)
	end
end
setmetatable(Type, { __call = |_, name| -> new Type(name) })

function Resource(name)
	ivkr_push_string(name)
	ivkr_call(ivkr_find_global("Resource"), 1)
	if name == "/Lotus/Types/Lore/PrimaryCodexManifest" then
		return new CodexManifest()
	end
	return new Object()
end

function WeakResource(name)
	ivkr_push_string(name)
	ivkr_call(ivkr_find_global("WeakResource"), 1)
	return new ObjectType()
end

function Range(minValue, maxValue)
	return { minValue = minValue, maxValue = maxValue }
end

function ivkr_pop_range()
	ivkr_push_value(-1)
	ivkr_call(ivkr_find_getter("Range", "minValue"), 1)
	local minValue = ivkr_pop_number()
	ivkr_call(ivkr_find_getter("Range", "maxValue"), 1)
	local maxValue = ivkr_pop_number()
	return Range(minValue, maxValue)
end

function Localize(loctag, subs = {})
	ivkr_push_string(loctag)
	ivkr_newtable()
	for k, v in subs do
		ivkr_push_string(k)
		ivkr_push_string(v)
		ivkr_settable(-3)
	end
	ivkr_call(ivkr_find_global("Localize"), 2)
	return ivkr_pop_string()
end

function Engine.OpenLevel(args)
	args:pushToIvkr()
	ivkr_call(ivkr_find_global("OpenLevel"), 1)
end

function UISys.ScriptResLoader_Create(names)
	ivkr_newtable()
	for k, v in ipairs(names) do
		ivkr_push_int(k)
		ivkr_push_string(v)
		ivkr_settable(-3)
	end
	ivkr_call(ivkr_find_global("ScriptResLoader_Create"), 1)
	return new UISys.ScriptResLoader()
end

function AngleToDirection(rot)
	ivkr_push_rotation(rot)
	ivkr_call(ivkr_find_global("AngleToDirection"), 1)
	return ivkr_pop_vector()
end

gRegion = {
	function GetLocalPlayer()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetLocalPlayer"), 1)
		if ivkr_type(-1) > 0 then
			return new LotusHumanPlayer()
		end
	end,
	function GetLocalPlayerAvatar()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetLocalPlayerAvatar"), 1)
		if ivkr_type(-1) > 0 then
			return ivkr_pop_entity()
		end
	end,
	function GetGameCamera()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetGameCamera"), 1)
		if ivkr_type(-1) > 0 then
			return new Entity()
		end
	end,
	function GetGameRules()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetGameRules"), 1)
		ivkr_push_value(-1)
		ivkr_call(ivkr_find_method("Object", "GetType"), 1)
		local type = new ObjectType()
		if type:isNameInHierarchy("LotusAttractModeGameRules") then
			return new LotusAttractModeGameRules()
		end
		if type:isNameInHierarchy("LotusHubGameRules") then
			return new LotusHubGameRules()
		end
		if type:isNameInHierarchy("LotusGameRules") then
			return new LotusGameRules()
		end
		if type:isNameInHierarchy("GameRulesImpl") then
			return new GameRulesImpl()
		end
		return new Object()
	end,
	function GetAvatars()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetAvatars"), 1)
		local t = {}
		local i = 1
		while (ivkr_push_int(i) and nil) or (ivkr_gettable(-2) > 0) do
			t:insert(new LotusAvatar())
			++i
		end
		ivkr_pop(2)
		return t
	end,
	function FindFirstTagged(symbol)
		ivkr_push_object(get_regionmgr())
		symbol:pushToIvkr()
		ivkr_call(ivkr_find_method("RegionMgrImpl", "FindFirstTagged"), 2)
		if ivkr_type(-1) > 0 do
			return ivkr_pop_entity()
		else
			ivkr_pop(1)
		end
	end,
	function FindTagged(symbol)
		ivkr_push_object(get_regionmgr())
		symbol:pushToIvkr()
		ivkr_call(ivkr_find_method("RegionMgrImpl", "FindTagged"), 2)
		return ivkr_pop_entity_array()
	end,
	function FindAll(type)
		ivkr_push_object(get_regionmgr())
		type:pushToIvkr()
		ivkr_call(ivkr_find_method("RegionMgrImpl", "FindAll"), 2)
		return ivkr_pop_entity_array()
	end,
	function CreateObject(type)
		ivkr_push_object(get_regionmgr())
		type:pushToIvkr()
		ivkr_call(ivkr_find_method("RegionMgrImpl", "CreateObject"), 2)
		if ivkr_typename(-1) == "LotusArtifactUpgrade *" then
			return new LotusArtifactUpgrade()
		end
		return new Object()
	end,
	function CreateEntity(type, pos, rot)
		ivkr_push_object(get_regionmgr())
		type:pushToIvkr()
		ivkr_push_vector(pos or gRegion:GetLocalPlayerAvatar():GetPosition()) -- Optional for compatibility with older OpenWF versions
		ivkr_push_rotation(rot or gRegion:GetLocalPlayerAvatar():GetRotation()) -- Optional for compatibility with older OpenWF versions
		ivkr_call(ivkr_find_method("RegionMgrImpl", "CreateEntity"), 4)
		return ivkr_pop_entity()
	end,
	function GetNpcMgr()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetNpcMgr"), 1)
		return new NpcManager()
	end,
	function Raycast(fromPos, toPos, avatar, _, outPos)
		ivkr_call(ivkr_find_ctor("Vector3"), 0)

		ivkr_push_object(get_regionmgr())
		ivkr_push_vector(fromPos)
		ivkr_push_vector(toPos)
		avatar:pushToIvkr()
		ivkr_push_nil()
		ivkr_push_value(-6)
		ivkr_call(ivkr_find_method("RegionMgrImpl", "Raycast"), 6)

		local ok = ivkr_type(-1) > 0
		ivkr_pop(1)

		local vec = ivkr_pop_vector()
		outPos.x = vec.x
		outPos.y = vec.y
		outPos.z = vec.z

		return ok
	end,
	function GetLevelInfo()
		ivkr_push_object(get_regionmgr())
		ivkr_call(ivkr_find_method("RegionMgrImpl", "GetLevelInfo"), 1)
		return new LevelInfo()
	end,
}

setmetatable(_G, {
	function __index(name)
		if name == "gGameRules" then
			return gRegion:GetGameRules()
		elseif name == "gGameData" then
			if addr := get_gamedata() then
				ivkr_push_object(addr)
				return new LotusProfileData()
			end
		elseif name == "gStarChart" then
			local gr = gRegion:GetGameRules()
			if gr instanceof LotusAttractModeGameRules then
				return gr:GetStarChart()
			end
			return gr:GetCurrentStarChart()
		else
			return rawget(self, name)
		end
	end
})

