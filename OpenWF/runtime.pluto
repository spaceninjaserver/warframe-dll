class BaseEntity extends Object
	__name = "BaseEntity"
end

function ivkr_pop_entity()
	if ivkr_type(-1) > 0 then
		ivkr_push_value(-1)
		ivkr_call(ivkr_find_method("Object", "GetType"), 1)
		local type = new ObjectType()
		repeat
			switch type:GetFullName() do
				case "/EE/Types/Engine/BaseMarkerInfo": return new BaseMarkerInfo()
				case "/EE/Types/Engine/Effect": return new Effect()
				case "/EE/Types/Effects/LensFlare": return new LensFlare()
				case "/EE/Types/Engine/Decoration": return new Decoration()
				case "/Lotus/Types/Game/LotusAvatar": return new LotusAvatar()
				case "/Lotus/Types/Game/LotusNpcAvatar": return new LotusNpcAvatar()
				case "/Lotus/Types/Game/LotusVehicleAvatar": return new LotusVehicleAvatar()
				case "/EE/Types/Effects/DynamicSky": return new DynamicSky()
			end
			type = type:GetParent()
		until not type
		return new Entity()
	else
		ivkr_pop(1)
	end
end

function ivkr_pop_entity_array()
	local t = {}
	if ivkr_type(-1) == IVKR_TABLE then
		local i = 1
		while (ivkr_push_int(i) and nil) or (ivkr_gettable(-2) > 0) do
			t:insert(ivkr_pop_entity())
			++i
		end
		ivkr_pop(2)
	else
		ivkr_pop(1)
	end
	return t
end

class Entity extends BaseEntity
	__name = "Entity"

	function GetPosition()
		self:pushToIvkr()
		return new Vector(entity_get_pos(ivkr_pop_object()))
	end

	function SetPosition(pos)
		self:pushToIvkr()
		ivkr_push_vector(pos)
		ivkr_call(ivkr_find_method("Entity", "SetPosition"), 2)
	end

	function DistanceToEntity(b)
		return GetPosition():distance(b:GetPosition())
	end

	function GetRotation()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetRotation"), 1)
		return ivkr_pop_rotation()
	end

	function GetSimRotation()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetSimRotation"), 1)
		return ivkr_pop_rotation()
	end

	function SetRotation(rot)
		self:pushToIvkr()
		ivkr_push_rotation(rot)
		ivkr_call(ivkr_find_method("Entity", "SetRotation"), 2)
	end

	function GetHealth()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetHealth"), 1)
		return math.tointeger(ivkr_pop_number())
	end

	function SetHealth(health)
		self:pushToIvkr()
		ivkr_push_int(health)
		ivkr_call(ivkr_find_method("Entity", "SetHealth"), 2)
	end

	function GetDrawOnTop()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetDrawOnTop"), 1)
		return ivkr_pop_bool()
	end

	function SetDrawOnTop(b)
		self:pushToIvkr()
		ivkr_push_bool(b)
		ivkr_call(ivkr_find_method("Entity", "SetDrawOnTop"), 2)
	end

	function GetMeshScale()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetMeshScale"), 1)
		return ivkr_pop_number()
	end

	function SetMeshScale(f)
		self:pushToIvkr()
		ivkr_push_float(f)
		ivkr_call(ivkr_find_method("Entity", "SetMeshScale"), 2)
	end

	function GetMesh()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetMesh"), 1)
		if ivkr_type(-1) > 0 do
			return new Mesh()
		end
		ivkr_pop(1)
	end

	function SetMesh(object, b1, b2)
		self:pushToIvkr()
		object:pushToIvkr()
		ivkr_push_bool(b1)
		ivkr_push_bool(b2)
		ivkr_call(ivkr_find_method("Entity", "SetMesh"), 4)
	end

	function Attach(type, optionalBoneSymbol, optionalPosOffset)
		self:pushToIvkr()
		type:pushToIvkr()
		;(optionalBoneSymbol or EMPTY_SYMBOL):pushToIvkr()
		if optionalPosOffset then
			ivkr_push_vector(optionalPosOffset)
		end
		ivkr_call(ivkr_find_method("Entity", "Attach"), optionalPosOffset ? 4 : 3)
		return ivkr_pop_entity()
	end

	function GetAttachment(type)
		self:pushToIvkr()
		type:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetAttachment"), 2)
		return ivkr_pop_entity()
	end

	function GetAllAttachments(type)
		self:pushToIvkr()
		type:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetAllAttachments"), 2)
		return ivkr_pop_entity_array()
	end

	function GetTag()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetTag"), 1)
		return ivkr_pop_symbol()
	end

	function SetTag(symbol)
		self:pushToIvkr()
		symbol:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "SetTag"), 2)
	end

	function FirePort(port)
		self:pushToIvkr()
		ivkr_push_string(port)
		ivkr_call(ivkr_find_method("Entity", "FirePort"), 2)
	end

	function SetVisibility(visible, delegateToAttachments = false)
		self:pushToIvkr()
		ivkr_push_bool(visible)
		ivkr_push_bool(delegateToAttachments)
		ivkr_call(ivkr_find_method("Entity", "SetVisibility"), 3)
	end

	function GetSpeed()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "GetSpeed"), 1)
		return ivkr_pop_number()
	end

	function Destroy()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("Entity", "Destroy"), 1)
	end

	function SetMaterialParam(symbol, f1, f2 = 3.4028235e38, f3 = 3.4028235e38, f4 = 3.4028235e38, b = false)
		self:pushToIvkr()
		symbol:pushToIvkr()
		ivkr_push_float(f1)
		ivkr_push_float(f2)
		ivkr_push_float(f3)
		ivkr_push_float(f4)
		ivkr_push_bool(b)
		ivkr_call(ivkr_find_method("Entity", "SetMaterialParam"), 7)
	end

	function RunScript(resource, funcSymbol, b)
		self:pushToIvkr()
		resource:pushToIvkr()
		funcSymbol:pushToIvkr()
		ivkr_push_bool(b)
		ivkr_call(ivkr_find_method("Entity", "RunScript"), 4)
	end
end

class BaseAvatar extends Entity
	__name = "BaseAvatar"

	function GetMaxHealth(scaled = true)
		self:pushToIvkr()
		ivkr_push_bool(scaled)
		ivkr_call(ivkr_find_method("BaseAvatar", "GetMaxHealth"), 2)
		return math.tointeger(ivkr_pop_number())
	end

	function SetMaxHealth(health, setBase = false)
		self:pushToIvkr()
		ivkr_push_int(health)
		ivkr_push_bool(setBase)
		ivkr_call(ivkr_find_method("BaseAvatar", "SetMaxHealth"), 3)
	end

	function Suicide()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("BaseAvatar", "Suicide"), 1)
	end

	function DamageControl()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("BaseAvatar", "DamageControl"), 1)
		return new LotusDamageController()
	end

	function InventoryControl()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("BaseAvatar", "InventoryControl"), 1)
		local inventory = new LotusInventoryController()
		if not "NullInventoryController" in inventory:GetFullName() then
			return inventory
		end
	end

	function InputControl()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("BaseAvatar", "InputControl"), 1)
		if ivkr_type(-1) > 0 do
			return new InputController()
		end
		ivkr_pop(1)
	end

	function GiveItem(type, b)
		self:pushToIvkr()
		type:pushToIvkr()
		ivkr_push_bool(b)
		ivkr_call(ivkr_find_method("BaseAvatar", "GiveItem"), 3)
		if ivkr_typename(-1) == "PowerSuit *" then
			return new PowerSuit()
		end
		ivkr_pop(1)
	end

	function MotionControl()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("BaseAvatar", "MotionControl"), 1)
		if ivkr_type(-1) > 0 do
			local motion = new MotionControllerBase()
			if motion:GetType():isNameInHierarchy("LotusSpaceFlightMotionController") then
				motion:pushToIvkr()
				return new LotusSpaceFlightMotionController()
			end
			return motion
		end
		ivkr_pop(1)
	end

	function GetView()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("BaseAvatar", "GetView"), 1)
		return ivkr_pop_rotation()
	end

	function SetView(rot)
		self:pushToIvkr()
		ivkr_push_rotation(rot)
		ivkr_call(ivkr_find_method("BaseAvatar", "SetView"), 2)
	end

