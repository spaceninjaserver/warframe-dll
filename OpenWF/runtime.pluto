		ivkr_pop(2)
	end
end

owf_script_toggles = {}
function owf_script_add_toggle(name, value = false)
	local toggle = {
		name = name,
		value = value
	}
	owf_script_toggles:insert(toggle)
	return toggle
end

function owf_command(cmd)
	if res := owf_command_raw(cmd) then
		return json.decode(res)
	end
	local channel, text = cmd:split("?", 2):unpack()
	if inst := owf_script_send_message(channel, text or "") then
		while owf_script_is_reply_pending(inst) do
			yield()
		end
		if r := owf_script_get_reply(inst) then
			return json.decode(r)
		end
	end
end

function owf_get_available_scripts()
	return owf_command("available_scripts").available_scripts
end

function owf_get_running_scripts()
	return owf_command("running_scripts").running_scripts:filter(|x| -> x:sub(1, 15) == "OpenWF/Scripts/"):map(|x| -> x:sub(16))
end

function owf_get_running_scripts_ex()
	return owf_command("running_scripts").running_scripts
end

function owf_start_script(name)
	http.request("http://localhost:"..owf_get_client_http_port().."/start_script?"..url.encode("OpenWF/Scripts/"..name))
end

function owf_start_script_inline(code)
	http.request("http://localhost:"..owf_get_client_http_port().."/start_script_inline?"..url.encode(code))
end

function owf_stop_script(name)
	owf_command("stop_script?OpenWF/Scripts/"..name)
end

function owf_toggle_script(name)
	if name in owf_get_running_scripts() then
		owf_stop_script(name)
	else
		owf_start_script(name)
	end
end

function owf_get_build_label()
