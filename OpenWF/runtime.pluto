class WeaponImpactBehavior extends Object
	__name = "WeaponImpactBehavior"

	function __index(name)
		if Object[name] then
			return Object[name]
		end
		switch name do
			case "criticalHitChance":
			case "criticalHitDamageMultiplier":
			case "instantImpulse":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("WeaponImpactBehavior", name), 1)
				return ivkr_pop_number()
		end
	end

	function __newindex(name, value)
		switch name do
			case "criticalHitChance":
			case "criticalHitDamageMultiplier":
			case "instantImpulse":
				self:pushToIvkr()
				ivkr_push_float(value)
				ivkr_call(ivkr_find_setter("WeaponImpactBehavior", name), 2)
		end
	end
end

