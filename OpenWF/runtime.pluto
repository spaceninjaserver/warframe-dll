function chat_system_reply(text)
	if ivkr_push_chat_redux() then
		ivkr_push_string("SystemMessage")
		ivkr_gettable(-2)
		ivkr_push_value(-2)
		ivkr_push_string(text)
		ivkr_call2(2, 0)

		ivkr_pop(1)
	end
end

function chat_add_to_sent_history(text)
	if ivkr_push_chat_redux() then
		ivkr_push_string("mPanelList")
		assert(ivkr_gettable(-2) == IVKR_TABLE)
		ivkr_push_nil()
		if ivkr_next(-2) then
			ivkr_push_string("OnMessageSent")
			ivkr_gettable(-2)
			local i = 0
			local j = 0
			while true do
				ivkr_get_upvalue(i)
				if ivkr_type(-1) == IVKR_FUNCTION and ++j == 2 then
					break
				end
				ivkr_pop(1)
				++i
			end
			ivkr_push_string(text)
			ivkr_call2(1, 0)
			ivkr_pop(3)
		end
		ivkr_pop(2)
	end
end

function chat_get_sent_history()
	local res
	if ivkr_push_chat_redux() then
		ivkr_push_string("mPanelList")
		assert(ivkr_gettable(-2) == IVKR_TABLE)
		ivkr_push_nil()
		if ivkr_next(-2) then
			ivkr_push_string("OnMessageSent")
			ivkr_gettable(-2)
			local i = 0
			local j = 0
			while true do
				ivkr_get_upvalue(i)
				if ivkr_type(-1) == IVKR_FUNCTION and ++j == 2 then
					break
				end
				ivkr_pop(1)
				++i
			end
			ivkr_get_upvalue(1)
			res = ivkr_pop_string_array()
			ivkr_pop(4)
		end
		ivkr_pop(2)
	end
	return res
end

