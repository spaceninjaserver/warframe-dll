class Item extends Object
	__name = "Item"

	function GetAttachmentEntity(category, hand = 4)
		-- restricting category to avoid access violations
		if category == 0 or category == 1 then
			self:pushToIvkr()
			ivkr_push_int(category)
			ivkr_push_int(hand)
			ivkr_call(ivkr_find_method("Item", "GetAttachmentEntity"), 3)
			if ivkr_type(-1) > 0 do
				return new Entity()
			end
			ivkr_pop(1)
		end
	end

	function GetEnergyColor(outColor, secondary = false)
		ivkr_call(ivkr_find_ctor("Color"), 0)

		self:pushToIvkr()
		ivkr_push_value(-2)
		ivkr_push_bool(secondary)
		ivkr_call(ivkr_find_method("Item", "GetEnergyColor"), 3)
		local b = ivkr_pop_bool()

		local c = ivkr_pop_color()
		outColor.red = c.red
		outColor.green = c.green
		outColor.blue = c.blue
		outColor.alpha = c.alpha

		return b
	end
end

