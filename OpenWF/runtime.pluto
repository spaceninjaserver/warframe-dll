LotusHudStatusTypes = {}

class LotusHudStatusTypes.FlashMarker extends owfUserdata
	__name = "LotusHudStatusTypes.FlashMarker"

	function ScreenX()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("LotusHudStatusTypes::FlashMarker", "ScreenX"), 1)
		return ivkr_pop_number()
	end

	function ScreenY()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("LotusHudStatusTypes::FlashMarker", "ScreenY"), 1)
		return ivkr_pop_number()
	end

	function ScreenZ()
		self:pushToIvkr()
		ivkr_call(ivkr_find_method("LotusHudStatusTypes::FlashMarker", "ScreenZ"), 1)
		return ivkr_pop_number()
	end

	function __index(name)
		if LotusHudStatusTypes.FlashMarker[name] then
			return LotusHudStatusTypes.FlashMarker[name]
		end
		switch name do
			case "garbage":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusHudStatusTypes::FlashMarker", name), 1)
				return ivkr_pop_bool()

			case "markerType":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusHudStatusTypes::FlashMarker", name), 1)
				return math.tointeger(ivkr_pop_number())

			case "distanceToEye":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusHudStatusTypes::FlashMarker", name), 1)
				return ivkr_pop_number()

			case "pos":
				do
					self:pushToIvkr()
					ivkr_call(ivkr_find_getter("LotusHudStatusTypes::FlashMarker", name), 1)
					return ivkr_pop_vector()
				end
				break

			case "baseMarkerInfo":
				self:pushToIvkr()
				ivkr_call(ivkr_find_getter("LotusHudStatusTypes::FlashMarker", "baseMarkerInfo"), 1)
				return new BaseMarkerInfo()
		end
		error("Unknown field: "..name)
	end
end

