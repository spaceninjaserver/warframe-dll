-- Modifications to sample scripts will be lost the next time you start the game.
if compareversions(owf_get_build_version(), "2019.08.29.20.01") < 0 then
	chat_system_reply("Loot Party is not available in this version. Use U25.7 or later.")
	return
end
repeat
	for gRegion:GetAvatars() as avatar do
		if inventory := avatar:InventoryControl() then
			inventory:DoItemDrop()
		end
	end
until yield()