if compareversions(owf_get_build_version(), "2017.03.26.04.21") < 0 then
	chat_system_reply("Freecam Teleport on Disable is not available in this version. Use U20 or later.")
	return
end
local last_pos
repeat
	if player := gRegion:GetLocalPlayer() then
		if player:IsFreeCameraActive() then
			last_pos = gRegion:GetGameCamera():GetPosition()
		elseif last_pos then
			if avatar := gRegion:GetLocalPlayerAvatar() then
				avatar:SetPosition(last_pos)
			end
			last_pos = nil
		end
	end
until yield()