-- Classes

Vector = require "pluto:vector3"
end

class Rotation
	function __construct(public heading = 0, public pitch = 0, public bank = 0) end
	function __tostring() end
end

class Symbol
	function __construct(public name = "") end
	function __eq(b) end
	function __tostring() end
	function c_str() end
end

class Color
